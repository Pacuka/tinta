<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.type.watch" />

    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Updates sent over from the phone app (never downloaded by the watch) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name="${applicationName}"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="Tinta"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- Declare that this is a WearOS app paired with the phone app -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false"
            tools:replace="android:value" />

        <!-- Phone app capability for pairing -->
        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version" />

        <activity
            android:name="app.zan1456.folio.wear.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/AppTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Listens for data from the phone app via Wearable Data Layer -->
        <service
            android:name="app.zan1456.folio.wear.WearDataListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <action android:name="com.google.android.gms.wearable.CHANNEL_EVENT" />
                <data
                    android:host="*"
                    android:pathPrefix="/folio"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <!-- Result of installing an update the phone sent -->
        <receiver
            android:name="app.zan1456.folio.wear.InstallResultReceiver"
            android:exported="false" />

        <!-- Glance: the current lesson without opening the app -->
        <service
            android:name="app.zan1456.folio.wear.glance.TintaTileService"
            android:exported="true"
            android:label="Tinta"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@mipmap/ic_launcher" />
        </service>

        <service
            android:name="app.zan1456.folio.wear.glance.TintaComplicationService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="Tinta óra"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT,LONG_TEXT,RANGED_VALUE" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="300" />
        </service>

        <meta-data android:name="flutterEmbedding" android:value="2" />
    </application>

    <!-- WearOS capability declaration – phone app uses this to find the watch app -->
    <queries>
        <package android:name="app.zan1456.folio" />
    </queries>
</manifest>
