            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/wave_k9"
            android:indeterminateOnly="false"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/live_wave_10"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/wave_k10"
            android:indeterminateOnly="false"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/live_wave_11"
            android:layout_width="0dp"
