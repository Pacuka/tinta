<?xml version="1.0" encoding="utf-8"?>
<!-- Élő óra-értesítés, kinyitott nézet: mint a kicsi, plusz egy sor arról, mi jön utána. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/live_title"
            style="@style/TextAppearance.Compat.Notification.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1" />

        <Chronometer
            android:id="@+id/live_timer"
            style="@style/TextAppearance.Compat.Notification.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/live_body"
        style="@style/TextAppearance.Compat.Notification.Line2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1" />

    <TextView
        android:id="@+id/live_next"
        style="@style/TextAppearance.Compat.Notification.Line2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="2" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:layout_marginTop="6dp">

        <ImageView
            android:id="@+id/live_progress"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY" />

        <!-- Mozgó hullám (Android 12+): a weightSum-mal állítjuk, hogy a
             szélesség hányad része legyen; a hullámhossz szerint választunk. -->
        <LinearLayout
            android:id="@+id/live_wave_row"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:visibility="gone">
        <ProgressBar
            android:id="@+id/live_wave_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/wave_k1"
            android:indeterminateOnly="false"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/live_wave_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/wave_k2"
            android:indeterminateOnly="false"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/live_wave_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/wave_k3"
            android:indeterminateOnly="false"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/live_wave_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/wave_k4"
            android:indeterminateOnly="false"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/live_wave_5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/wave_k5"
            android:indeterminateOnly="false"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/live_wave_6"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/wave_k6"
            android:indeterminateOnly="false"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/live_wave_7"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/wave_k7"
            android:indeterminateOnly="false"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/live_wave_8"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/wave_k8"
            android:indeterminateOnly="false"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/live_wave_9"
            android:layout_width="0dp"
