            android:layout_weight="1"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/wave_k11"
            android:indeterminateOnly="false"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/live_wave_12"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/wave_k12"
            android:indeterminateOnly="false"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/live_wave_13"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/wave_k13"
            android:indeterminateOnly="false"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/live_wave_14"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/wave_k14"
            android:indeterminateOnly="false"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/live_wave_15"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/wave_k15"
            android:indeterminateOnly="false"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/live_wave_16"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/wave_k16"
            android:indeterminateOnly="false"
            android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
