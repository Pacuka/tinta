<!-- GitHub / sideload flavor — adds the permission required for APK self-update.
     It is intentionally absent from src/main/ so the Play Store build
     never declares it, regardless of manifest merger behaviour.
     The update is downloaded into the app's own cache, so no storage
     permission is needed. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- APK install -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

</manifest>
